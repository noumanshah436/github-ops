# Saved automatically when you add tokens on the Tokens page. You can also set them here,
# or `export` them in your shell before starting the backend.
GITHUB_TOKEN=          # create PRs; read PRs, checks and Actions; re-run/cancel runs
GITHUB_TOKEN_MERGE=    # approve and merge (a different account from the PR author)

# Optional overrides
# GH_OPS_PORT=8765
